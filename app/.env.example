# External-wallet SIWE login; derived EOA + EIP-7702, no account database.
# REQUIRED: stable random 32-byte hex secret. Back it up; rotating changes all app wallets.
# Server only: never use a VITE_ prefix or commit real values.
# WALLET_MASTER_SECRET=

# One-time API-wallet 7702 initialization needs sponsor MON on mainnet (143) only.
# NFT/product transactions are signed by the external wallet, which pays its own gas.
# Falls back to GROKBOT_WEB3_WALLET locally/cloud.
# PAYMASTER_SIGNER=

# User-funded Monad mainnet USDC x402 payments.
# Same chat model as msgs; alternatively minimax/minimax-m3.
# X402_CHAT_MODEL=xai/grok-4.3
# Unset: Grok for text-only jobs, image-01 for jobs with a private reference.
# To require MiniMax for all jobs: X402_IMAGE_MODEL=image-01
# Explicit Grok cannot accept reference images on the verified route.

# Temporary migration fallback: direct MiniMax CN, paid by the platform API key.
# Defaults on when this key is set; chat MiniMax-M3, images image-01.
# Only before any user USDC payment; no fallback for ambiguous/settled requests.
# MINIMAX_CN_API_KEY=
# AIM_TEMP_MINIMAX_FALLBACK=false

# Local product-login bypass; paid AI still requires a verified wallet session.
# VITE_AUTH_ENABLED=false

# Private idol content only; no account tables. Required for runtime catalog/editors.
# idols100x_DATABASE_URL=
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Keep the bucket private; no public domain or R2_PUBLIC_URL.
# Notion is read only by the one-time migration, never by runtime.
# NOTION_TOKEN=
# NOTION_IMAGES_DATABASE_ID=NOTION_DATABASE_ID_REMOVED

# Contract deployment key; server only.
# PRIVATE_KEY=
# NFT, subscriptions, faucet and tips stay on Monad testnet using LUSD.
# Live contract and RPC constants are in src/lib/idols100x.ts.
