# Server-only. Preserve the EXACT existing master secret for browser-wallet compatibility.
# Never paste secrets into chat or commit them. Set through your environment secret manager.
WALLET_MASTER_SECRET=
AIM100X_DATABASE_URL=

# Official Alchemy endpoints. No public-RPC fallback; NEVER prefix these with VITE_.
# https://monad-mainnet.g.alchemy.com/v2/<your-api-key> (chain 143)
ALCHEMY_MONAD_MAINNET_RPC_URL=
# https://monad-testnet.g.alchemy.com/v2/<your-api-key> (chain 10143)
ALCHEMY_MONAD_TESTNET_RPC_URL=

# Privy authentication only; no Privy wallets are created.
# Match the public app ID on frontend/backend. Verification key is the dashboard's ES256 public PEM.
PRIVY_APP_ID=
VITE_PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# Choose the permanent RP hostname before creating Mera passkeys; no scheme/port/path.
# Frontend/backend must match. Use a separate environment/hostname for development.
MERA_RP_ID=
VITE_MERA_RP_ID=
VITE_AUTH_ENABLED=true

# Platform signer funds all supported APP-wallet business gas on testnet.
# Mainnet delegation is disabled. Login never delegates a wallet.
PAYMASTER_SIGNER=

# Historical media routing overrides; mainnet USDC payments remain disabled.
# Allowlisted Hub chat models: xai/grok-4.3, minimax/minimax-m3, moonshot/kimi-k3.
# Selecting a model here does not enable x402 spend.
X402_CHAT_MODEL=xai/grok-4.3
X402_IMAGE_MODEL=
# Optional temporary platform-paid chat/image fallback (never after uncertain payment).
MINIMAX_CN_API_KEY=
AIM_TEMP_MINIMAX_FALLBACK=false

# Private media storage. Bucket is fixed in code as aim100x.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional read-only integration probe. Leave false for offline unit tests.
RUN_CHAIN_TESTS=false

# Testnet text flow (see docs/testnet-text-acceptance.md):
# MINIMAX_CN_API_KEY is now required for direct CN text chat, not a Hub fallback.
# PAYMASTER_SIGNER funds all supported testnet APP-wallet business gas and receives text LUSD.
# Fund that platform signer with Monad TESTNET MON; users need no MON/mainnet USDC.
# Text price is fixed in code at 1 LUSD/message. Gas allowance: 1 testnet MON/wallet/UTC day.
# Run npm run auth:init -w app to initialize text billing and gas allowance tables.
# No mainnet enable switch exists. Keep primary auth and testnet RPC settings above.
