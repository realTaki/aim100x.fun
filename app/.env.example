# Sign-in is Passkey only (WebAuthn / Face ID). Session state lives in the browser; the server stores nothing.
# Set to "false" to skip login and use the shared local dev user.
# VITE_AUTH_ENABLED=false

# AI / Notion / chain — no application database.
# Chat, images, TTS, and STT use MiniMax CN only.
# MINIMAX_CN_API_KEY=
# NOTION_TOKEN=

# Paymaster signer / minter / deployer. Same key as Cloud Agent GROKBOT_WEB3_WALLET
# (Grokbot EOA 0xa445BaC003026F5aDf51760CA850ad66750e90ad). Never the user's signing key. Never commit.
# Local/cloud: unset PAYMASTER_SIGNER and GROKBOT_WEB3_WALLET is used.
# PAYMASTER_SIGNER=

# Idols100x deploy (Monad testnet). Same Grokbot wallet as PAYMASTER_SIGNER — never commit values.
# PRIVATE_KEY=
# Live Idols100x address and Monad RPC are hardcoded in src/lib/idols100x.ts — do not set them on Vercel.
# Payment token is LonelyUSD (LUSD) — not Circle testnet USDC. Address is in src/lib/idols100x.ts.
